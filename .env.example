APP_NAME="Sepand Customer Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database owned by portal-customer. Laravel migrations, consultation requests,
# queues and other website-owned data are stored only in this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sepand_portal
DB_USERNAME=sepand_portal
DB_PASSWORD=

# Independent, preferably read-only, connection to the sepand-crm database.
# DB_DATABASE and CRM_DB_DATABASE must never point to the same database.
CUSTOMER_PORTAL_DB_CONNECTION=crm
CRM_DB_CONNECTION=mysql
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=3306
CRM_DB_DATABASE=sepand_crm
CRM_DB_USERNAME=sepand_portal_readonly
CRM_DB_PASSWORD=
CRM_DB_SOCKET=
CRM_MYSQL_ATTR_SSL_CA=

# Used as the default value for portal-owned activity logs. Login itself is
# multi-tenant and discovers every active CRM tenant linked to the mobile.
CUSTOMER_PORTAL_TENANT_ID=00000000-0000-0000-0000-000000000001
CUSTOMER_PORTAL_PREVIEW_OTP=true
CUSTOMER_PORTAL_OTP_EXPIRES=120
CUSTOMER_PORTAL_OTP_RESEND_AFTER=45
CUSTOMER_PORTAL_OTP_MAX_ATTEMPTS=5
CUSTOMER_PORTAL_OTP_MAX_REQUESTS=5
CUSTOMER_PORTAL_OTP_REQUEST_DECAY=600

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
